# Local clock for engagement grouping & smart post times (IANA, e.g. America/Chicago)
# NEXT_PUBLIC_DEALER_TZ=America/Chicago

# Video: optional in-browser 720p for every video (upload original + compressed when under size cap)
# NEXT_PUBLIC_USE_CLIENT_FFMPEG=1
# Video: max file size (MB) before we skip direct upload and use in-browser 720p only (default 45). Match or stay under Supabase Storage → file size limit.
# NEXT_PUBLIC_MAX_DIRECT_VIDEO_UPLOAD_MB=45
# Video: system ffmpeg binary path (overrides bundled ffmpeg-static)
# FFMPEG_PATH=/opt/homebrew/bin/ffmpeg

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Use one of these (new dashboards: Publishable key often starts with sb_publishable_…)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_…
