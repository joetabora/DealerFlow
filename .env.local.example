# Local clock for engagement grouping & smart post times (IANA, e.g. America/Chicago)
# NEXT_PUBLIC_DEALER_TZ=America/Chicago

# Video: optional in-browser 720p for every video (upload original + compressed when under size cap)
# NEXT_PUBLIC_USE_CLIENT_FFMPEG=1
# Video: max file size (MB) before we skip direct upload and use in-browser 720p only (default 45). Match or stay under Supabase Storage → file size limit.
# NEXT_PUBLIC_MAX_DIRECT_VIDEO_UPLOAD_MB=45
# Video: system ffmpeg binary path (overrides bundled ffmpeg-static)
# FFMPEG_PATH=/opt/homebrew/bin/ffmpeg

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Use one of these (new dashboards: Publishable key often starts with sb_publishable_…)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_…

# Auth middleware: unset or anything except "false" → users must sign in at /login
# NEXT_PUBLIC_REQUIRE_AUTH=false

# Local-only escape hatch for UI work (never public + permissive RLS)
# NEXT_PUBLIC_SKIP_LOGIN=1

# ── Elite pipeline (optional cron ingest + caption templates) ──
# Server-only Supabase bypass for cron CSV jobs — never expose to browsers
# SUPABASE_SERVICE_ROLE_KEY=

# Cron auth header: Authorization: Bearer <CRON_SECRET> (see Vercel Cron docs)
# CRON_SECRET=

# CSV URL synced by GET /api/cron/inventory-sync
# INV_CSV_SYNC_URL=https://example.com/secure/inventory.csv
# INV_CSV_PROFILE=default
# INV_CSV_PROFILE=mbws

# Named templates (src/lib/caption/templates.ts): fb_feed_simple | ig_feed_simple | ig_reel_caption
# NEXT_PUBLIC_CAPTION_TEMPLATE=fb_feed_simple
# NEXT_PUBLIC_DEFAULT_CAPTION_CTA=Call today for pricing and financing.
