# Local clock for engagement grouping & smart post times (IANA, e.g. America/Chicago)
# NEXT_PUBLIC_DEALER_TZ=America/Chicago

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Use one of these (new dashboards: Publishable key often starts with sb_publishable_…)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_…
